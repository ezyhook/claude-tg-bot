TELEGRAM_BOT_TOKEN=
ALLOWED_CHAT_ID=
OWNER_ID=
WORK_DIR=/home/user

# Lumo via lumo-tamer (OpenAI-compatible API)
# inside the ai-stack compose network: http://tamer:3003/v1, on the host: http://127.0.0.1:3003/v1
LUMO_BASE_URL=http://tamer:3003/v1
LUMO_API_KEY=
# lumo | lumo-lite | lumo-max (can be changed in chat: /model)
LUMO_MODEL=lumo

# optional tuning
# LUMO_MAX_STEPS=25          # tool rounds per message
# LUMO_HISTORY_MAX=60        # messages sent to Lumo per request
# LUMO_TOOL_OUTPUT_MAX=8000  # chars of command output sent back to Lumo
# LUMO_CMD_TIMEOUT=120       # seconds per command
# LUMO_REQUEST_TIMEOUT=300   # seconds per Lumo request
