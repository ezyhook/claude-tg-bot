[Unit]
Description=Telegram <-> Claude Code bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/claude-tg-bot
Environment=PATH=%h/.local/node/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/node/bin/node --env-file=.env bot.mjs
Restart=always
RestartSec=5
StandardOutput=append:%h/claude-tg-bot/bot.log
StandardError=append:%h/claude-tg-bot/bot.log

[Install]
WantedBy=default.target
